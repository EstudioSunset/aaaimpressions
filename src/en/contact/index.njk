---json
{
  "lang": "en",
  "hreflangEn": "/en/contact/",
  "hreflangEs": "/es/contacto/",
  "schema": "home",
  "hideCta": true,
  "title": "Contact: Request a Proposal | AAA Impressions",
  "metaDescription": "Request a proposal for B2B marketing or bilingual documentation. Reply within one business day, in English or Spanish. WhatsApp 772-940-1928.",
  "breadcrumb": [
    {
      "label": "Contact"
    }
  ],
  "hero": {
    "eyebrow": "Contact",
    "title": "Tell us what you need. <em>We'll reply in writing.</em>",
    "lede": "Clear scope, timeline and price, in English or Spanish.",
    "noCta": true
  },
  "sections": [],
  "layout": "layouts/b2b-page.njk"
}
---

<section class="py-20 lg:py-24 bg-white">
  <div class="mx-auto max-w-6xl px-5 grid lg:grid-cols-5 gap-12 lg:gap-16">
    <div class="lg:col-span-3">
      <h2 class="text-2xl mb-2">Request a proposal</h2>
      <p class="text-gray-500 mb-8">We reply within one business day with questions or a written quote.</p>
      <form action="{{ site.contactEndpoint or 'https://api.web3forms.com/submit' }}" method="POST" class="grid sm:grid-cols-2 gap-5">
        <input type="hidden" name="lang" value="en">
        <input type="hidden" name="access_key" value="b7214d3c-a9cb-45a9-a3e9-718367dbc5fd">
        <input type="hidden" name="subject" value="New B2B proposal request | AAA Impressions">
        <input type="hidden" name="from_name" value="AAA Impressions Web">
        <input type="hidden" name="redirect" value="{{ site.baseUrl }}/en/contact-thank-you/">
        <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off">
        <div><label for="ct-company" class="block text-sm font-semibold mb-2">Company <span style="color:var(--accent)" aria-hidden="true">*</span></label><input type="text" id="ct-company" name="company" required autocomplete="organization" class="w-full border px-4 py-3"></div>
        <div><label for="ct-name" class="block text-sm font-semibold mb-2">Your name <span style="color:var(--accent)" aria-hidden="true">*</span></label><input type="text" id="ct-name" name="name" required autocomplete="name" class="w-full border px-4 py-3"></div>
        <div><label for="ct-role" class="block text-sm font-semibold mb-2">Role <span class="text-gray-500 font-normal">(optional)</span></label><input type="text" id="ct-role" name="role" autocomplete="organization-title" class="w-full border px-4 py-3"></div>
        <div><label for="ct-email" class="block text-sm font-semibold mb-2">Work email <span style="color:var(--accent)" aria-hidden="true">*</span></label><input type="email" id="ct-email" name="email" required autocomplete="email" class="w-full border px-4 py-3"></div>
        <div><label for="ct-phone" class="block text-sm font-semibold mb-2">Phone <span class="text-gray-500 font-normal">(optional)</span></label><input type="tel" id="ct-phone" name="phone" autocomplete="tel" class="w-full border px-4 py-3"></div>
        <div><label for="ct-service" class="block text-sm font-semibold mb-2">Service</label><select id="ct-service" name="service" class="w-full border px-4 py-3 bg-white"><option>Branded spec sheets</option><option>HazCom program (bilingual)</option><option>OSHA/ANSI safety signs</option><option>Lockout/tagout procedures</option><option>Forklift training materials</option><option>Workplace posters</option><option>Pool chemical Spanish labels</option><option>E-commerce product content</option><option>Spanish jingles and audio</option><option>Bilingual AI automation</option><option>B2B website</option><option>Google / Microsoft Ads</option><option>Branding</option><option>LinkedIn and social</option><option>Other</option></select></div>
        <div><label for="ct-volume" class="block text-sm font-semibold mb-2">Approximate volume</label><select id="ct-volume" name="volume" class="w-full border px-4 py-3 bg-white"><option>1–25 items</option><option>26–100 items</option><option>100+ items</option><option>Ongoing / monthly</option><option>Not sure yet</option></select></div>
        <div class="sm:col-span-2"><label for="ct-message" class="block text-sm font-semibold mb-2">What do you need? <span style="color:var(--accent)" aria-hidden="true">*</span></label><textarea id="ct-message" name="message" required rows="5" class="w-full border px-4 py-3"></textarea></div>
        <p class="sm:col-span-2 b2b-note text-sm">Have a sample file? After you submit, email it to <a class="underline" href="mailto:{{ site.email }}">{{ site.email }}</a> or send it by <a class="underline" href="{{ site.whatsapp }}" target="_blank" rel="noopener noreferrer">WhatsApp</a>.</p>
        {% if site.turnstileSiteKey %}<div class="sm:col-span-2 cf-turnstile" data-sitekey="{{ site.turnstileSiteKey }}" data-language="en"></div><script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>{% endif %}
        <button type="submit" class="sm:col-span-2 btn-primary justify-center py-4">Send request →</button>
        <p class="sm:col-span-2 text-xs text-gray-500 text-center">We only use your information to reply to this request.</p>
      </form>
    </div>
    <aside class="lg:col-span-2 space-y-8">
      <div><h3 class="text-lg mb-1">WhatsApp</h3><p class="text-gray-500 mb-2">Fastest way to send a file or a question.</p><a class="font-semibold underline" href="{{ site.whatsapp }}" target="_blank" rel="noopener noreferrer">{{ site.phone }}</a></div>
      <div><h3 class="text-lg mb-1">Phone</h3><p class="text-gray-500 mb-2">Calls are answered in English or Spanish.</p><a class="font-semibold underline" href="tel:{{ site.phoneRaw }}">{{ site.phone }}</a></div>
      <div><h3 class="text-lg mb-1">Email</h3><a class="font-semibold underline" href="mailto:{{ site.email }}">{{ site.email }}</a></div>
      <div><h3 class="text-lg mb-1">Location</h3><p class="text-gray-500">Treasure Coast, Florida · Remote across the US</p></div>
    </aside>
  </div>
</section>
