<article class="py-16 lg:py-24 bg-white">
  <div class="mx-auto max-w-4xl px-5">
    <img
      src="https://images.unsplash.com/photo-1596526131083-e8c633c948d2?w=900&q=80&auto=format&fit=crop"
      alt="Bandeja de entrada con novedades de producto para distribuidores y contratistas"
      class="w-full rounded-2xl object-cover mb-10"
      style="max-height:380px"
