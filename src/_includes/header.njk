{% set isEs = lang == "es" %}
{% if isEs %}
  {% set navItems = [["/es/servicios/","Marketing B2B"],["/es/soluciones/","Soluciones"],["/es/industrias/","Industrias"],["/es/blog/","Recursos"],["/es/sobre-nosotros/","Nosotros"],["/es/contacto/","Contacto"]] %}
{% else %}
  {% set navItems = [["/en/services/","B2B Marketing"],["/en/solutions/","Solutions"],["/en/industries/","Industries"],["/en/blog/","Resources"],["/en/about/","About"],["/en/contact/","Contact"]] %}
{% endif %}
{% set proposalUrl = "/es/contacto/" if isEs else "/en/contact/" %}

<!-- ── Topbar ── -->
<div class="site-topbar" role="banner" aria-label="{{ 'Información del sitio' if isEs else 'Site info' }}">
  <div class="site-topbar-inner">
    <div class="site-topbar-left">
      <span class="site-topbar-item">
        <svg viewBox="0 0 24 24" width="11" height="11" fill="currentColor" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
        Treasure Coast, FL
      </span>
      <span class="site-topbar-sep" aria-hidden="true"></span>
      <span class="site-topbar-item is-secondary">{{ "Servicio remoto en EE.UU. · Inglés y español" if isEs else "Remote across the US · English & Spanish" }}</span>
    </div>
    <a href="tel:{{ site.phoneRaw }}" class="site-topbar-phone">
      <svg viewBox="0 0 24 24" width="11" height="11" fill="currentColor" aria-hidden="true"><path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.02-.24 11.36 11.36 0 003.57.57 1 1 0 011 1V20a1 1 0 01-1 1C10.61 21 3 13.39 3 4a1 1 0 011-1h3.5a1 1 0 011 1 11.36 11.36 0 00.57 3.57 1 1 0 01-.25 1.02z"/></svg>
      {{ site.phone }}
    </a>
  </div>
</div>

<header id="top" data-header class="site-header">
  <div class="site-nav-inner mx-auto max-w-6xl px-5">
    <div class="site-nav-row flex items-center justify-between">

      <a href="{{ '/es/' if isEs else '/en/' }}" class="site-brand flex items-center gap-3" aria-label="AAA Impressions - {{ 'Inicio' if isEs else 'Home' }}">
        <img src="/assets/img/logo.webp" alt="AAA Impressions" width="180" height="36" class="h-9 w-auto">
      </a>

      <nav class="hidden lg:flex items-center gap-6 xl:gap-8" aria-label="{{ 'Navegación principal' if isEs else 'Main navigation' }}">
        {% for item in navItems %}<a class="nav-link{{ ' active' if page.url.startsWith(item[0]) }}" href="{{ item[0] }}">{{ item[1] }}</a>
        {% endfor %}
      </nav>

      <div class="flex items-center gap-3">
        {% if hreflangEs or hreflangEn %}
        <div class="flex items-center border border-gray-200 bg-white overflow-hidden text-xs font-semibold">
          {% if hreflangEs %}<a href="{{ hreflangEs }}" class="lang-btn px-3 py-1.5 {{ 'active' if isEs else 'text-gray-500 hover:text-gray-700' }}" hreflang="es" aria-label="Versión en español">ES</a>{% endif %}
          {% if hreflangEn %}<a href="{{ hreflangEn }}" class="lang-btn px-3 py-1.5 {{ 'active' if not isEs else 'text-gray-500 hover:text-gray-700' }}" hreflang="en" aria-label="English version">EN</a>{% endif %}
        </div>
        {% endif %}

        <a href="{{ proposalUrl }}" class="nav-cta hidden sm:inline-flex">{{ "Solicitar propuesta" if isEs else "Request a proposal" }}</a>

        <button id="menuBtn" class="lg:hidden p-2 border border-gray-200 bg-white hover:bg-gray-50 transition"
                aria-label="{{ 'Abrir menú' if isEs else 'Open menu' }}" aria-expanded="false" aria-controls="mobileMenu">
          <svg id="iconOpen" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
          <svg id="iconClose" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
    </div>

    <div id="mobileMenu" class="hidden lg:hidden pb-4">
      <nav class="border border-gray-100 bg-white p-3 grid gap-1" aria-label="{{ 'Menú móvil' if isEs else 'Mobile menu' }}">
        {% for item in navItems %}<a class="px-4 py-2.5 hover:bg-gray-50 font-medium transition" href="{{ item[0] }}">{{ item[1] }}</a>
        {% endfor %}
        <a class="nav-cta mt-2 justify-center" href="{{ proposalUrl }}">{{ "Solicitar propuesta" if isEs else "Request a proposal" }}</a>
        <a class="px-4 py-2.5 text-center font-medium" href="{{ site.whatsapp }}" target="_blank" rel="noopener noreferrer">WhatsApp {{ site.phone }}</a>
      </nav>
    </div>
  </div>
</header>
