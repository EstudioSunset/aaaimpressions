{% set isEs = lang == "es" %}
<footer style="background:var(--dark)" class="py-14">
  <div class="mx-auto max-w-6xl px-5">
    <div class="grid gap-10 md:grid-cols-4">
      <div>
        <a href="{{ '/es/' if isEs else '/en/' }}" class="inline-block mb-4">
          <img src="/assets/img/aaa-impressions-logo-white.webp" alt="AAA Impressions" width="169" height="56" class="h-14 w-auto" loading="lazy">
        </a>
        <p class="text-gray-500 text-sm leading-relaxed mb-5">
          {{ "Marketing industrial y documentación técnica para fabricantes, bodegas y constructoras. En inglés y español. Treasure Coast, FL · Servicio remoto en EE.UU." if isEs else "Industrial marketing and technical documentation for manufacturers, warehouses and contractors. English & Spanish. Treasure Coast, FL · Remote across the US." }}
        </p>
        <div class="flex flex-col gap-1.5 text-sm">
          <a href="tel:{{ site.phoneRaw }}" class="text-gray-400 hover:text-white transition">{{ site.phone }}</a>
          <a href="mailto:{{ site.email }}" class="text-gray-400 hover:text-white transition">{{ site.email }}</a>
        </div>
      </div>
      {% if isEs %}
        {% set cols = [
          ["Soluciones", [["/es/soluciones/fichas-tecnicas/","Fichas técnicas"],["/es/soluciones/seguridad-capacitacion-bilingue/","Seguridad y cumplimiento"],["/es/soluciones/hazcom-comunicacion-de-peligros/","Programa HazCom"],["/es/soluciones/senalizacion-seguridad-osha-ansi/","Letreros OSHA/ANSI"],["/es/soluciones/contenido-de-producto/","Contenido de producto"],["/es/soluciones/traduccion-tecnica/","Traducción técnica"],["/es/soluciones/jingles-en-espanol/","Jingles en español"],["/es/soluciones/automatizacion-ia/","Automatización con IA"]]],
          ["Marketing industrial", [["/es/servicios/diseno-web-treasure-coast/","Sitios web industriales"],["/es/servicios/google-ads-treasure-coast/","Google y Microsoft Ads"],["/es/servicios/branding-diseno-logo-treasure-coast/","Branding industrial"],["/es/servicios/manejo-redes-sociales-treasure-coast/","LinkedIn y redes"],["/es/servicios/materiales-impresos-treasure-coast/","Impresión para empresas"],["/es/servicios/agencia-marketing-digital-treasure-coast/","Estrategia y SEO"]]],
          ["Empresa", [["/es/industrias/","Industrias"],["/es/como-trabajamos/","Cómo trabajamos"],["/es/casos-de-estudio/","Muestras de trabajo"],["/es/blog/","Recursos"],["/es/area-de-servicio/","Área de servicio"],["/es/sobre-nosotros/","Nosotros"],["/es/contacto/","Contacto"]]]
        ] %}
      {% else %}
        {% set cols = [
          ["Solutions", [["/en/solutions/spec-sheets/","Spec sheets"],["/en/solutions/bilingual-safety-training/","Safety & compliance"],["/en/solutions/hazcom-bilingual-program/","HazCom program"],["/en/solutions/osha-ansi-safety-signs/","OSHA/ANSI signs"],["/en/solutions/product-content/","Product content"],["/en/solutions/technical-translation/","Technical translation"],["/en/solutions/spanish-jingles/","Spanish jingles"],["/en/solutions/ai-automation/","AI automation"]]],
          ["Industrial marketing", [["/en/services/web-design-treasure-coast/","Industrial websites"],["/en/services/google-ads-treasure-coast/","Google & Microsoft Ads"],["/en/services/branding-logo-design-treasure-coast/","Industrial branding"],["/en/services/social-media-management-treasure-coast/","LinkedIn & social"],["/en/services/print-materials-treasure-coast/","Business printing"],["/en/services/digital-marketing-treasure-coast/","Strategy & SEO"]]],
          ["Company", [["/en/industries/","Industries"],["/en/how-we-work/","How we work"],["/en/case-studies/","Work samples"],["/en/blog/","Resources"],["/en/service-area/","Service area"],["/en/about/","About"],["/en/contact/","Contact"]]]
        ] %}
      {% endif %}
      {% for col in cols %}
      <div>
        <p class="text-xs font-semibold tracking-widest uppercase mb-4">{{ col[0] }}</p>
        <ul class="space-y-2.5 text-sm">
          {% for l in col[1] %}<li><a class="text-gray-500 hover:text-white transition" href="{{ l[0] }}">{{ l[1] }}</a></li>{% endfor %}
        </ul>
      </div>
      {% endfor %}
    </div>
    <div class="mt-10 pt-6 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-gray-600 text-xs">© <span id="yr"></span> AAA Impressions · {{ "Todos los derechos reservados." if isEs else "All rights reserved." }} · Treasure Coast, Florida</p>
      <div class="flex gap-4 text-xs">
        <a class="text-gray-500 hover:text-white" href="{{ site.facebook }}" target="_blank" rel="noopener noreferrer">Facebook</a>
        <a class="text-gray-500 hover:text-white" href="{{ site.whatsapp }}" target="_blank" rel="noopener noreferrer">WhatsApp</a>
      </div>
    </div>
  </div>
</footer>
