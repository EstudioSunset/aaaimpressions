{% set isEs = lang == "es" %}
<figure class="spec-visual m-0" role="img" aria-label="{{ 'Ejemplo de ficha técnica bilingüe de cable THHN para una distribuidora ficticia' if isEs else 'Sample bilingual data sheet for THHN wire from a fictional distributor' }}">
  <div class="spec-visual__bar"><span>PRODUCT DATA SHEET / FICHA TÉCNICA</span><span>REV. 02</span></div>
  <div class="spec-visual__head">
    <div>
      <strong>THHN/THWN-2 · 12 AWG</strong>
      <span>SKU MRS-THHN12-500-BK · 500 ft reel / carrete</span>
    </div>
    <div class="spec-visual__brand">
      <svg class="spec-visual__logo-svg" viewBox="0 0 64 64" aria-hidden="true">
        <rect width="64" height="64" fill="#182C8C"/>
        <path d="M10 44 L22 22 L32 36 L42 18 L54 44" fill="none" stroke="#fff" stroke-width="5" stroke-linejoin="miter" stroke-linecap="square"/>
        <path d="M10 52 Q19 47 28 52 T46 52 T54 50" fill="none" stroke="#7A5CFF" stroke-width="4" stroke-linecap="square"/>
      </svg>
      <span class="spec-visual__brand-name">MANATEE RIDGE<br>SUPPLY CO.</span>
    </div>
  </div>
  <div class="spec-visual__table">
    <span class="is-h">SPECIFICATION / ESPECIFICACIÓN</span><span class="is-h is-es">VALUE / VALOR</span>
    <span>Voltage rating<em>Tensión nominal</em></span><span>600 V</span>
    <span>Temperature rating<em>Temperatura máxima</em></span><span>90 °C dry / wet · seco / mojado</span>
    <span>Conductor<em>Conductor</em></span><span>Solid copper · Cobre sólido</span>
    <span>Insulation<em>Aislamiento</em></span><span>PVC + nylon jacket · PVC con cubierta de nylon</span>
    <span>Standard<em>Norma</em></span><span>UL 83 · NEC</span>
  </div>
  <div class="spec-visual__warn"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#5C4300" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 2 21h20L12 3z"/><path d="M12 10v5"/><path d="M12 18h.01"/></svg><span><strong>WARNING / ADVERTENCIA:</strong> Shock hazard. De-energize before installing. / Riesgo de descarga. Desenergice antes de instalar.</span></div>
  <p class="spec-visual__sample">{{ "Marca ficticia · ejemplo de diseño" if isEs else "Fictional brand · design sample" }}</p>
</figure>
