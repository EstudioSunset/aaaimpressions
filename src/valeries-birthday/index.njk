    renderThumbnails();
    renderSlide(0, false);
    renderFavorites();
    setupMenu();
    setupVideoPlaceholder();
    setupFavoriteScroller();

    document.getElementById("vbPrev").addEventListener("click", () => goToSlide(state.index - 1));
    document.getElementById("vbNext").addEventListener("click", () => goToSlide(state.index + 1));
    favoriteButton.addEventListener("click", toggleFavorite);
    shareButton.addEventListener("click", shareCurrentPhoto);
    downloadLink.addEventListener("click", guardDownload);
    photo.addEventListener("load", () => frame.classList.remove("is-placeholder"));
    photo.addEventListener("error", () => {
      const fallback = photo.dataset.fallbackSrc;
      if (fallback && photo.src !== fallback) {
        photo.src = fallback;
        photo.dataset.fallbackSrc = "";
        return;
      }
      frame.classList.add("is-placeholder");
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") goToSlide(state.index - 1);
      if (event.key === "ArrowRight") goToSlide(state.index + 1);
    });

    function setupFavoriteScroller() {
      favoritePrev.addEventListener("click", () => scrollFavorites(-1));
      favoriteNext.addEventListener("click", () => scrollFavorites(1));
    }

    function scrollFavorites(direction) {
      const amount = Math.max(favoriteList.clientWidth * 0.78, 240);
      favoriteList.scrollBy({ left: amount * direction, behavior: "smooth" });
    }

    function loadFavorites() {
      try {
        const stored = JSON.parse(localStorage.getItem(STORAGE_KEY) || "[]");
        return Array.isArray(stored) ? stored : [];
      } catch (error) {
        return [];
      }
    }

    function saveFavorites() {
      localStorage.setItem(STORAGE_KEY, JSON.stringify([...state.favorites]));
    }

    function goToSlide(nextIndex) {
      const normalized = (nextIndex + slides.length) % slides.length;
      renderSlide(normalized, true);
    }

    function renderSlide(nextIndex, animate) {
      state.index = nextIndex;
      const current = slides[state.index];
      const displaySrc = current.displayImage || current.image;
      const imageReady = isReadyUrl(displaySrc);
      const overlayReady = isReadyUrl(current.overlay);

      if (animate) {
        frame.classList.add("is-changing");
        window.setTimeout(() => frame.classList.remove("is-changing"), 180);
      }

      title.textContent = current.title;
      caption.textContent = current.caption;
      currentCount.textContent = `${state.index + 1} / ${slides.length}`;
      progress.style.width = `${((state.index + 1) / slides.length) * 100}%`;

      frame.classList.toggle("is-placeholder", !imageReady);
      if (imageReady) {
        photo.dataset.fallbackSrc = current.image || "";
        photo.src = displaySrc;
        photo.alt = current.title;
      }

      if (overlayReady) {
        overlay.hidden = false;
        overlay.src = current.overlay;
      } else {
        overlay.hidden = true;
      }

      const isFavorite = state.favorites.has(current.id);
      favoriteButton.setAttribute("aria-pressed", String(isFavorite));
      favoriteButton.setAttribute(
        "aria-label",
        isFavorite ? "Quitar de favoritas para impresion" : "Marcar como favorita para impresion"
      );

      const downloadUrl = imageReady ? (current.downloadUrl || current.image.replace("export=view", "export=download")) : "#";
      downloadLink.href = downloadUrl;
      downloadLink.setAttribute("download", current.downloadName);
      downloadLink.setAttribute("aria-disabled", String(!imageReady));

      document.querySelectorAll(".vb-thumb").forEach((button) => {
        button.classList.toggle("is-active", Number(button.dataset.slideIndex) === state.index);
      });
    }

    function renderThumbnails() {
      thumbs.innerHTML = "";

      slides.forEach((slide, index) => {
        const button = document.createElement("button");
        button.className = "vb-thumb";
        button.type = "button";
        button.dataset.slideIndex = String(index);
        button.setAttribute("aria-label", "Ver " + slide.title);

        const media = document.createElement("span");
        media.className = "vb-thumb__media";

        if (isReadyUrl(slide.image)) {
          const image = document.createElement("img");
          image.src = slide.thumbnail || slide.image;
          image.alt = "";
          image.loading = "lazy";
          media.appendChild(image);
        }

        const number = document.createElement("span");
        number.textContent = String(index + 1).padStart(2, "0");
        media.appendChild(number);

        const copy = document.createElement("span");
        copy.className = "vb-thumb__copy";
        copy.innerHTML = `<strong>${escapeHtml(slide.title)}</strong><span>${escapeHtml(slide.caption)}</span>`;

        button.append(media, copy);
        button.addEventListener("click", () => renderSlide(index, true));
        thumbs.appendChild(button);
      });
    }

    function toggleFavorite() {
      const current = slides[state.index];

      if (state.favorites.has(current.id)) {
        state.favorites.delete(current.id);
        showToast("Foto removida de favoritas.");
      } else {
        state.favorites.add(current.id);
        showToast("Foto marcada para impresion.");
      }

      saveFavorites();
      renderSlide(state.index, false);
      renderFavorites();
    }

    function renderFavorites() {
      const selected = slides.filter((slide) => state.favorites.has(slide.id));
      favoriteCount.textContent = String(selected.length);
      favoriteStatus.textContent = `${selected.length} ${selected.length === 1 ? "seleccionada" : "seleccionadas"}`;
      favoriteList.innerHTML = "";
      favoritePrev.disabled = selected.length === 0;
      favoriteNext.disabled = selected.length === 0;

      if (!selected.length) {
        const empty = document.createElement("p");
        empty.className = "vb-empty";
        empty.textContent = "Aun no hay fotos favoritas.";
        favoriteList.appendChild(empty);
        return;
      }

      selected.forEach((slide) => {
        const index = slides.findIndex((item) => item.id === slide.id);
        const button = document.createElement("button");
        button.className = "vb-thumb";
        button.type = "button";
        button.dataset.slideIndex = String(index);
        button.setAttribute("aria-label", "Ver favorita " + slide.title);

        const media = document.createElement("span");
        media.className = "vb-thumb__media";

        if (isReadyUrl(slide.image)) {
          const image = document.createElement("img");
          image.src = slide.thumbnail || slide.image;
          image.alt = "";
          image.loading = "lazy";
          media.appendChild(image);
        }

        const number = document.createElement("span");
        number.textContent = String(index + 1).padStart(2, "0");
        media.appendChild(number);

        const copy = document.createElement("span");
        copy.className = "vb-thumb__copy";
        copy.innerHTML = `<strong>${escapeHtml(slide.title)}</strong><span>Lista para imprimir</span>`;

        button.append(media, copy);
        button.addEventListener("click", () => {
          renderSlide(index, true);
          frame.scrollIntoView({ behavior: "smooth", block: "center" });
        });
        favoriteList.appendChild(button);
      });
    }

    async function shareCurrentPhoto() {
      const current = slides[state.index];
      const shareUrl = isReadyUrl(current.viewUrl) ? current.viewUrl : window.location.href;
      const shareData = {
        title: "Valerie's Birthday - " + current.title,
        text: "Mira esta foto de Valerie's Birthday.",
        url: shareUrl
      };

      if (navigator.share) {
        try {
          await navigator.share(shareData);
        } catch (error) {
          if (error.name !== "AbortError") showToast("No se pudo compartir ahora.");
        }
        return;
      }

      if (navigator.clipboard) {
        await navigator.clipboard.writeText(shareUrl);
        showToast("Enlace copiado.");
        return;
      }

      showToast("Comparte copiando el enlace del navegador.");
    }

    function guardDownload(event) {
      if (downloadLink.getAttribute("aria-disabled") === "true") {
        event.preventDefault();
        showToast("Agrega el ID real de Google Drive para descargar.");
      }
    }

    function setupMenu() {
      menuToggle.addEventListener("click", () => {
        const isOpen = menu.classList.toggle("is-open");
        menuToggle.setAttribute("aria-expanded", String(isOpen));
      });

      menu.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          menu.classList.remove("is-open");
          menuToggle.setAttribute("aria-expanded", "false");
        });
      });

      const sections = ["galeria", "favoritas", "video"]
        .map((id) => document.getElementById(id))
        .filter(Boolean);

      if (!("IntersectionObserver" in window)) return;

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          menu.querySelectorAll("a").forEach((link) => {
            link.classList.toggle("is-active", link.getAttribute("href") === "#" + entry.target.id);
          });
        });
      }, { rootMargin: "-40% 0px -50% 0px", threshold: 0 });

      sections.forEach((section) => observer.observe(section));
    }

    function setupVideoPlaceholder() {
      const source = video.querySelector("source");
      const posterReady = isReadyUrl(video.getAttribute("poster"));
      const sourceReady = source && isReadyUrl(source.getAttribute("src"));

      videoFrame.classList.toggle("is-placeholder", !sourceReady);

      if (!posterReady) {
        video.removeAttribute("poster");
      }
    }

    function isReadyUrl(url) {
      return Boolean(url && !url.includes("TU_ID_AQUI"));
    }

    function escapeHtml(value) {
      const div = document.createElement("div");
      div.textContent = value;
      return div.innerHTML;
    }

    let toastTimer = null;
    function showToast(message) {
      window.clearTimeout(toastTimer);
      toast.textContent = message;
      toast.classList.add("is-visible");
      toastTimer = window.setTimeout(() => toast.classList.remove("is-visible"), 2200);
    }
  })();
</script>
