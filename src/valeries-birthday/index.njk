---
layout: "private-gallery.njk"
title: "Valerie's Birthday"
metaDescription: "Galeria privada de fotos y video para la familia de Valerie."
lang: "es"
permalink: /valeries-birthday/
eleventyExcludeFromCollections: true
noindex: true
---

<style>
  :root {
    --vb-ink: #171923;
    --vb-muted: #5b6370;
    --vb-paper: #fffdf8;
    --vb-panel: #ffffff;
    --vb-line: rgba(23, 25, 35, 0.13);
    --vb-teal: #067f8f;
    --vb-coral: #e85d3f;
    --vb-gold: #d69b2d;
    --vb-blush: #fff0eb;
    --vb-mint: #e9f7f4;
    --vb-shadow: 0 18px 55px rgba(23, 25, 35, 0.12);
    --vb-radius: 8px;
    color-scheme: light;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    color: var(--vb-ink);
    background: var(--vb-paper);
    -webkit-font-smoothing: antialiased;
  }

  button,
  a {
    -webkit-tap-highlight-color: transparent;
  }

  img,
  video {
    max-width: 100%;
  }

  .vb-page {
    min-height: 100vh;
    background: var(--vb-paper);
  }

  .vb-shell {
    width: min(1180px, calc(100% - 32px));
    margin: 0 auto;
  }

  .vb-nav {
    position: sticky;
    top: 0;
    z-index: 30;
    border-bottom: 1px solid var(--vb-line);
    background: rgba(255, 253, 248, 0.92);
    backdrop-filter: blur(16px);
  }

  .vb-nav__inner {
    width: min(1180px, calc(100% - 32px));
    min-height: 72px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
  }

  .vb-brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
    color: var(--vb-ink);
    text-decoration: none;
  }

  .vb-brand__mark {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(232, 93, 63, 0.25);
    border-radius: 50%;
    background: var(--vb-blush);
    color: var(--vb-coral);
    font-weight: 800;
  }

  .vb-brand__text {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .vb-brand__name {
    font-size: 0.96rem;
    font-weight: 800;
    line-height: 1.1;
  }

  .vb-brand__sub {
    color: var(--vb-muted);
    font-size: 0.78rem;
    font-weight: 600;
  }

  .vb-menu {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .vb-menu a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 38px;
    padding: 0 14px;
    border-radius: var(--vb-radius);
    color: var(--vb-muted);
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 800;
    transition: color 160ms ease, background 160ms ease;
  }

  .vb-menu a:hover,
  .vb-menu a.is-active {
    color: var(--vb-ink);
    background: var(--vb-mint);
  }

  .vb-menu-toggle {
    display: none;
    width: 42px;
    height: 42px;
    border: 1px solid var(--vb-line);
    border-radius: var(--vb-radius);
    background: var(--vb-panel);
    color: var(--vb-ink);
    cursor: pointer;
  }

  .vb-menu-toggle svg {
    width: 22px;
    height: 22px;
  }

  .vb-hero {
    min-height: calc(100vh - 72px);
    display: flex;
    align-items: center;
    padding: 42px 0 34px;
  }

  .vb-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.74fr) minmax(280px, 0.26fr);
    gap: 30px;
    align-items: end;
  }

  .vb-kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 14px;
    color: var(--vb-teal);
    font-size: 0.8rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .vb-kicker::before {
    content: "";
    width: 34px;
    height: 2px;
    background: var(--vb-coral);
  }

  .vb-title {
    margin: 0;
    max-width: 780px;
    font-size: 3.3rem;
    line-height: 1;
    font-weight: 900;
    letter-spacing: 0;
  }

  .vb-lede {
    margin: 18px 0 0;
    max-width: 650px;
    color: var(--vb-muted);
    font-size: 1rem;
    line-height: 1.7;
  }

  .vb-status {
    display: grid;
    gap: 12px;
    padding: 18px;
    border: 1px solid var(--vb-line);
    border-radius: var(--vb-radius);
    background: rgba(255, 255, 255, 0.82);
  }

  .vb-status__row {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    color: var(--vb-muted);
    font-size: 0.82rem;
    font-weight: 800;
  }

  .vb-status__row strong {
    color: var(--vb-ink);
  }

  .vb-gallery {
    min-height: calc(100vh - 72px);
    display: flex;
    align-items: center;
    padding: 18px 0 34px;
    background-color: var(--vb-paper);
    background-image:
      linear-gradient(180deg, rgba(255, 253, 248, 0.36), rgba(255, 253, 248, 0.20)),
      url("/assets/img/rapu.webp");
    background-position: center top, left top;
    background-size: auto, auto;
    background-repeat: repeat, repeat;
  }

  .vb-gallery__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 24px;
    align-items: start;
  }

  .vb-main {
    min-width: 0;
    display: grid;
    gap: 14px;
  }

  .vb-stage {
    overflow: hidden;
    border: 1px solid var(--vb-line);
    border-radius: var(--vb-radius);
    background: var(--vb-panel);
    box-shadow: var(--vb-shadow);
  }

  .vb-frame {
    position: relative;
    isolation: isolate;
    aspect-ratio: 16 / 9;
    min-height: clamp(360px, 58vh, 650px);
    overflow: hidden;
    background-color: #f6f1ea;
    background-image:
      linear-gradient(135deg, rgba(255, 253, 248, 0.42), rgba(255, 253, 248, 0.22)),
      url("/assets/img/rapu-2.webp");
    background-size: auto, auto;
    background-repeat: repeat, repeat;
    background-position: center, left top;
  }

  .vb-frame::before {
    content: "Valerie's Birthday";
    position: absolute;
    inset: 0;
    z-index: 0;
    display: grid;
    place-items: center;
    padding: 24px;
    color: rgba(23, 25, 35, 0.26);
    font-size: 2.1rem;
    font-weight: 900;
    text-align: center;
  }

  .vb-frame:not(.is-placeholder)::before {
    content: "";
  }

  .vb-photo {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    transition: opacity 220ms ease, transform 420ms ease;
  }

  .vb-frame.is-changing .vb-photo {
    opacity: 0;
    transform: scale(1.015);
  }

  .vb-frame.is-placeholder .vb-photo {
    opacity: 0;
  }

  .vb-overlay {
    position: absolute;
    inset: 0;
    z-index: 3;
    width: 100%;
    height: 100%;
    object-fit: contain;
    pointer-events: none;
  }

  .vb-overlay[hidden] {
    display: none;
  }

  .vb-arrow {
    position: absolute;
    top: 50%;
    z-index: 5;
    width: clamp(72px, 8vw, 112px);
    height: clamp(44px, 5vw, 68px);
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    filter: drop-shadow(0 10px 18px rgba(23, 25, 35, 0.32));
    transform: translateY(-50%);
    transition: filter 160ms ease, transform 160ms ease;
    overflow: visible;
  }

  .vb-arrow:hover {
    filter: drop-shadow(0 13px 22px rgba(23, 25, 35, 0.42));
    transform: translateY(-50%) scale(1.04);
  }

  .vb-arrow img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    pointer-events: none;
    filter: drop-shadow(0 0 14px rgba(255, 255, 255, 0.95))
            drop-shadow(0 0 22px rgba(255, 255, 255, 0.8))
            drop-shadow(0 0 28px rgba(246, 192, 95, 0.75))
            drop-shadow(0 7px 14px rgba(23, 25, 35, 0.28));
  }

  .vb-arrow--prev {
    left: 8px;
  }

  .vb-arrow--next {
    right: 8px;
  }

  .vb-meta {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 20px;
    align-items: center;
    padding: 14px 16px;
  }

  .vb-stats-inline {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 14px;
    margin-top: 8px;
    color: var(--vb-muted);
    font-size: 0.78rem;
    font-weight: 800;
  }

  .vb-stats-inline strong {
    color: var(--vb-ink);
  }

  .vb-slide-title {
    margin: 0 0 4px;
    font-size: 1.1rem;
    line-height: 1.25;
    font-weight: 900;
  }

  .vb-caption {
    margin: 0;
    color: var(--vb-muted);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .vb-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
  }

  .vb-icon-btn {
    width: 44px;
    height: 44px;
    display: inline-grid;
    place-items: center;
    border: 1px solid var(--vb-line);
    border-radius: var(--vb-radius);
    background: var(--vb-panel);
    color: var(--vb-ink);
    text-decoration: none;
    cursor: pointer;
    transition: border-color 160ms ease, color 160ms ease, background 160ms ease, transform 160ms ease;
  }

  .vb-icon-btn:hover {
    border-color: rgba(6, 127, 143, 0.45);
    color: var(--vb-teal);
    background: var(--vb-mint);
    transform: translateY(-1px);
  }

  .vb-icon-btn[aria-pressed="true"] {
    border-color: rgba(232, 93, 63, 0.48);
    color: var(--vb-coral);
    background: var(--vb-blush);
  }

  .vb-icon-btn[aria-disabled="true"] {
    color: rgba(23, 25, 35, 0.38);
    cursor: not-allowed;
    transform: none;
  }

  .vb-icon-btn svg {
    width: 21px;
    height: 21px;
  }

  .vb-progress {
    height: 4px;
    background: rgba(23, 25, 35, 0.08);
  }

  .vb-progress span {
    display: block;
    width: 0;
    height: 100%;
    background: linear-gradient(90deg, var(--vb-teal), var(--vb-coral));
    transition: width 220ms ease;
  }

  .vb-favorites-bar {
    min-width: 0;
    border: 1px solid var(--vb-line);
    border-radius: var(--vb-radius);
    background: rgba(255, 255, 255, 0.88);
    overflow: hidden;
    box-shadow: 0 14px 42px rgba(23, 25, 35, 0.1);
    backdrop-filter: blur(10px);
  }

  .vb-favorites-bar__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 14px;
    border-bottom: 1px solid var(--vb-line);
  }

  .vb-favorites-bar__head h2 {
    margin: 0;
    font-size: 0.94rem;
    line-height: 1.2;
  }

  .vb-favorites-actions {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .vb-strip-arrow {
    width: 36px;
    height: 36px;
    display: inline-grid;
    place-items: center;
    border: 1px solid var(--vb-line);
    border-radius: var(--vb-radius);
    background: var(--vb-panel);
    color: var(--vb-ink);
    cursor: pointer;
    transition: background 160ms ease, border-color 160ms ease, color 160ms ease, transform 160ms ease;
  }

  .vb-strip-arrow:hover {
    border-color: rgba(6, 127, 143, 0.45);
    color: var(--vb-teal);
    background: var(--vb-mint);
    transform: translateY(-1px);
  }

  .vb-strip-arrow:disabled {
    color: rgba(23, 25, 35, 0.32);
    cursor: not-allowed;
    transform: none;
  }

  .vb-strip-arrow svg {
    width: 18px;
    height: 18px;
  }

  .vb-side {
    display: grid;
    gap: 14px;
    align-self: start;
    position: sticky;
    top: 88px;
    max-height: calc(100vh - 104px);
    min-height: 0;
  }

  .vb-panel {
    min-height: 0;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--vb-line);
    border-radius: var(--vb-radius);
    background: rgba(255, 255, 255, 0.86);
    overflow: hidden;
    backdrop-filter: blur(10px);
  }

  .vb-panel--photos {
    min-height: 0;
  }

  .vb-panel__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 16px;
    border-bottom: 1px solid var(--vb-line);
  }

  .vb-panel__head h2 {
    margin: 0;
    font-size: 0.94rem;
    line-height: 1.2;
  }

  .vb-count {
    min-width: 28px;
    height: 28px;
    display: inline-grid;
    place-items: center;
    border-radius: 50%;
    background: var(--vb-mint);
    color: var(--vb-teal);
    font-size: 0.8rem;
    font-weight: 900;
  }

  .vb-thumb-grid {
    min-height: 0;
    display: grid;
    gap: 8px;
    padding: 12px;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: rgba(6, 127, 143, 0.45) rgba(23, 25, 35, 0.08);
    max-height: min(560px, calc(100vh - 278px));
  }

  .vb-favorite-list {
    min-height: 94px;
    display: flex;
    gap: 10px;
    padding: 12px;
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scrollbar-width: thin;
    scrollbar-color: rgba(6, 127, 143, 0.45) rgba(23, 25, 35, 0.08);
  }

  .vb-favorite-list .vb-thumb {
    flex: 0 0 clamp(220px, 28vw, 292px);
    background: rgba(255, 255, 255, 0.66);
    scroll-snap-align: start;
  }

  .vb-favorite-list .vb-empty {
    flex: 1 0 100%;
    display: grid;
    align-items: center;
    padding: 16px 4px;
  }

  .vb-thumb {
    width: 100%;
    display: grid;
    grid-template-columns: 62px minmax(0, 1fr);
    gap: 10px;
    align-items: center;
    padding: 8px;
    border: 1px solid transparent;
    border-radius: var(--vb-radius);
    background: transparent;
    color: var(--vb-ink);
    text-align: left;
    cursor: pointer;
    transition: background 160ms ease, border-color 160ms ease;
  }

  .vb-thumb:hover,
  .vb-thumb.is-active {
    border-color: rgba(6, 127, 143, 0.28);
    background: var(--vb-mint);
  }

  .vb-thumb__media {
    position: relative;
    width: 62px;
    height: 62px;
    overflow: hidden;
    border-radius: var(--vb-radius);
    background:
      linear-gradient(135deg, rgba(6, 127, 143, 0.18), rgba(214, 155, 45, 0.22)),
      #f6f1ea;
  }

  .vb-thumb__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .vb-thumb__media span {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: rgba(23, 25, 35, 0.52);
    font-size: 0.82rem;
    font-weight: 900;
  }

  .vb-thumb__copy {
    min-width: 0;
  }

  .vb-thumb__copy strong,
  .vb-thumb__copy span {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .vb-thumb__copy strong {
    font-size: 0.85rem;
    line-height: 1.25;
  }

  .vb-thumb__copy span {
    margin-top: 3px;
    color: var(--vb-muted);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .vb-empty {
    margin: 0;
    padding: 16px;
    color: var(--vb-muted);
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .vb-video-section {
    padding: 64px 0 82px;
    background-color: #171923;
    background-image:
      linear-gradient(180deg, rgba(23, 25, 35, 0.76), rgba(23, 25, 35, 0.68)),
      url("/assets/img/rapu-2.webp");
    background-position: center top, left top;
    background-size: auto, auto;
    background-repeat: repeat, repeat;
    color: #fff;
  }

  .vb-video-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.42fr) minmax(0, 0.58fr);
    gap: 28px;
    align-items: center;
  }

  .vb-video-copy h2 {
    margin: 0 0 12px;
    font-size: 2rem;
    line-height: 1.1;
    font-weight: 900;
    letter-spacing: 0;
  }

  .vb-video-copy p {
    margin: 0;
    max-width: 440px;
    color: rgba(255, 255, 255, 0.72);
    line-height: 1.7;
  }

  .vb-video-frame {
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: var(--vb-radius);
    background: #0f1118;
    box-shadow: 0 22px 65px rgba(0, 0, 0, 0.28);
  }

  .vb-video-frame::before {
    content: "";
    display: block;
    aspect-ratio: 16 / 9;
  }

  .vb-video-frame video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background: #0f1118;
  }

  .vb-video-frame.is-placeholder::after {
    content: "Video de Valerie";
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: rgba(255, 255, 255, 0.48);
    font-size: 1.2rem;
    font-weight: 900;
    pointer-events: none;
  }

  .vb-toast {
    position: fixed;
    left: 50%;
    bottom: 24px;
    z-index: 60;
    max-width: min(420px, calc(100% - 32px));
    padding: 12px 16px;
    border-radius: var(--vb-radius);
    background: #171923;
    color: #fff;
    box-shadow: var(--vb-shadow);
    font-size: 0.9rem;
    font-weight: 800;
    transform: translate(-50%, 18px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 180ms ease, transform 180ms ease;
  }

  .vb-toast.is-visible {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  @media (max-width: 960px) {
    .vb-hero__grid,
    .vb-gallery__grid,
    .vb-video-grid {
      grid-template-columns: 1fr;
    }

    .vb-side {
      position: static;
      max-height: none;
    }

    .vb-thumb-grid {
      max-height: 360px;
    }
  }

  @media (max-width: 760px) {
    .vb-nav__inner {
      min-height: 64px;
    }

    .vb-menu-toggle {
      display: inline-grid;
      place-items: center;
    }

    .vb-menu {
      position: absolute;
      top: 64px;
      left: 16px;
      right: 16px;
      display: grid;
      padding: 10px;
      border: 1px solid var(--vb-line);
      border-radius: var(--vb-radius);
      background: var(--vb-panel);
      box-shadow: var(--vb-shadow);
      transform: translateY(-8px);
      opacity: 0;
      pointer-events: none;
      transition: opacity 160ms ease, transform 160ms ease;
    }

    .vb-menu.is-open {
      transform: translateY(0);
      opacity: 1;
      pointer-events: auto;
    }

    .vb-menu a {
      justify-content: center;
    }

    .vb-title {
      font-size: 2.42rem;
    }

    .vb-thumb-grid {
      max-height: 320px;
    }

    .vb-frame {
      aspect-ratio: 4 / 5;
      min-height: min(68vh, 560px);
      background-size: auto, auto;
    }

    .vb-meta {
      grid-template-columns: 1fr;
    }

    .vb-actions {
      justify-content: flex-start;
    }
  }

  @media (max-width: 460px) {
    .vb-shell,
    .vb-nav__inner {
      width: min(100% - 20px, 1180px);
    }

    .vb-title {
      font-size: 2.04rem;
    }

    .vb-hero {
      padding-top: 30px;
    }

    .vb-frame {
      min-height: min(64vh, 500px);
    }

    .vb-arrow {
      width: 56px;
      height: 36px;
      filter: drop-shadow(0 8px 12px rgba(23, 25, 35, 0.28));
    }

    .vb-arrow img {
      filter: drop-shadow(0 0 10px rgba(255, 255, 255, 0.95))
              drop-shadow(0 0 16px rgba(255, 255, 255, 0.8))
              drop-shadow(0 0 20px rgba(246, 192, 95, 0.6));
    }

    .vb-arrow--prev {
      left: 4px;
    }

    .vb-arrow--next {
      right: 4px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
      transition-duration: 1ms !important;
      animation-duration: 1ms !important;
      animation-iteration-count: 1 !important;
    }
  }
</style>

<div class="vb-page">
  <nav class="vb-nav" aria-label="Menu de Valerie's Birthday">
    <div class="vb-nav__inner">
      <a class="vb-brand" href="#galeria" aria-label="Valerie's Birthday">
        <span class="vb-brand__mark" aria-hidden="true">V</span>
        <span class="vb-brand__text">
          <span class="vb-brand__name">Valerie's Birthday</span>
          <span class="vb-brand__sub">Galeria familiar privada</span>
        </span>
