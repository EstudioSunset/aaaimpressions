# Normalizar finales de línea: LF en el repositorio, siempre.
# Evita que Windows genere diffs de cientos de archivos por CRLF/BOM.
* text=auto eol=lf

# Binarios: git no debe tocarlos
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.gif   binary
*.ico   binary
*.svg   text eol=lf
*.pdf   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.mp4   binary
*.webm  binary
